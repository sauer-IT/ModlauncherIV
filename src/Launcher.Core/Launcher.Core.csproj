<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ModlauncherIV.Core</RootNamespace>
    <AssemblyName>ModlauncherIV.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Deliberately NO UseWPF/UseWindowsForms: the core stays free of UI,
         so that the pipeline is testable against fixtures. -->
  </PropertyGroup>

</Project>
