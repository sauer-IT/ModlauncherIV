<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ModlauncherIV.App</RootNamespace>
    <AssemblyName>ModlauncherIV</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Produced by scripts\make-icon.ps1. Windows uses it for the EXE, the
         Explorer, the taskbar and every shortcut pointing at it; WPF uses it
         as the window icon on top of that. -->
    <ApplicationIcon>..\..\assets\ModlauncherIV.ico</ApplicationIcon>

    <!-- Shows up in the file properties and in the SmartScreen dialog. Anyone
         downloading an unsigned EXE sees this text as the only hint at what the
         program is - so it deserves care. -->
    <Version>1.0.0</Version>
    <Product>Modlauncher IV</Product>
    <AssemblyTitle>Modlauncher IV</AssemblyTitle>
    <Description>Guided downgrader and mod installer for GTA IV</Description>
    <Copyright>GPL-3.0</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
  </ItemGroup>

  <!--
    The catalog travels into the output. It belongs to the program: without it
    the wizard knows not a single recipe. index.json and its signature are
    copied along - if the signature is missing, the launcher rightly loads
    nothing.
  -->
  <ItemGroup>
    <Content Include="..\..\catalog\**\*">
      <Link>catalog\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Files the launcher brings along itself - currently only its own trainer.
    They are still checked against the checksum in the recipe: being shipped is
    no bonus of trust, the folder sits next to a program and anyone with rights
    there can write into it.

    Created by scripts\pack-trainer.ps1. If the folder is missing nothing breaks
    here - the catalog then simply knows a recipe whose file is absent, and the
    wizard says so.
  -->
  <ItemGroup>
    <Content Include="bundled\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
