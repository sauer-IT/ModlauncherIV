<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ModlauncherIV.App</RootNamespace>
    <AssemblyName>ModlauncherIV</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Erzeugt von scripts\make-icon.ps1. Windows nimmt es fuer die EXE, den
         Explorer, die Taskleiste und jede Verknuepfung darauf; WPF nimmt es
         zusaetzlich als Fenstersymbol. -->
    <ApplicationIcon>..\..\assets\ModlauncherIV.ico</ApplicationIcon>

    <!-- Steht in den Dateieigenschaften und im SmartScreen-Dialog. Wer eine
         unsignierte EXE herunterlaedt, sieht diesen Text als einzigen Hinweis
         darauf, was das Programm ist - also gehoert er gepflegt. -->
    <Version>1.0.0</Version>
    <Product>Modlauncher IV</Product>
    <AssemblyTitle>Modlauncher IV</AssemblyTitle>
    <Description>Gefuehrter Downgrader und Mod-Installer fuer GTA IV</Description>
    <Copyright>GPL-3.0</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
  </ItemGroup>

  <!--
    Der Katalog wandert mit in die Ausgabe. Er gehoert zum Programm: ohne ihn
    kennt der Assistent kein einziges Rezept. Mitkopiert wird auch index.json
    samt Signatur - fehlt die, laedt der Launcher zu Recht nichts.
  -->
  <ItemGroup>
    <Content Include="..\..\catalog\**\*">
      <Link>catalog\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Dateien, die der Launcher selbst mitbringt - derzeit nur der eigene Trainer.
    Sie werden trotzdem gegen die Pruefsumme im Rezept geprueft: der
    Lieferumfang ist kein Vertrauensbonus, der Ordner liegt neben einem
    Programm, in den jeder schreiben kann, der dort Rechte hat.

    Angelegt von scripts\pack-trainer.ps1. Fehlt der Ordner, faellt hier nichts
    aus - dann kennt der Katalog eben ein Rezept, dessen Datei fehlt, und der
    Assistent sagt das auch.
  -->
  <ItemGroup>
    <Content Include="bundled\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
