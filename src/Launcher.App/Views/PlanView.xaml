<UserControl x:Class="ModlauncherIV.App.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="0,4,0,20">

        <ItemsControl ItemsSource="{Binding Problems}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#26E06C5A" BorderBrush="{StaticResource Bad}" BorderThickness="1"
                            CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}"
                                       Style="{StaticResource Dim}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding Detail, Converter={StaticResource HasContent}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Number}" Style="{StaticResource Dim}" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Head}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" Margin="0,3,0,0" />
                            </StackPanel>

                            <Border Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                    Background="{StaticResource PanelHi}" CornerRadius="3" Padding="8,4">
                                <TextBlock Text="{Binding State}" FontSize="11" Foreground="{StaticResource TextDim}" />
                            </Border>
                        </Grid>
                        <!-- Bereits Vorhandenes wird zurueckgenommen, nicht hervorgehoben:
                             der Blick soll auf dem liegen, was noch passieren wird. -->
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" Margin="0,10,0,0" />

    </StackPanel>
</UserControl>
