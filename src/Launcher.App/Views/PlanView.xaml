<UserControl x:Class="ModlauncherIV.App.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="0,4,0,20">

        <ItemsControl ItemsSource="{Binding Problems}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#26E06C5A" BorderBrush="{StaticResource Bad}" BorderThickness="1"
                            CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}"
                                       Style="{StaticResource Dim}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding Detail, Converter={StaticResource HasContent}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Number}" Style="{StaticResource Dim}" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Head}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" Margin="0,3,0,0" />
                            </StackPanel>

                            <Border Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                    Background="{StaticResource PanelHi}" CornerRadius="3" Padding="8,4">
                                <TextBlock Text="{Binding State}" FontSize="11" Foreground="{StaticResource TextDim}" />
                            </Border>
                        </Grid>
                        <!-- What is already there is played down, not highlighted: the eye
                             should rest on what is still going to happen. -->
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" Margin="0,10,0,0" />

        <!-- A version change moves the game out from under what is already
             installed. The files stay exactly where they were put, which is why
             nothing else on this page would ever mention them. -->
        <StackPanel Margin="0,18,0,0" Visibility="{Binding HasLeftBehind, Converter={StaticResource Show}}">
            <TextBlock Text="LEFT BEHIND BY THIS" Style="{StaticResource GroupHead}" />
            <TextBlock Text="{Binding LeftBehindLead}" Style="{StaticResource Dim}" Margin="0,6,0,8" />

            <ItemsControl ItemsSource="{Binding LeftBehind}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Head}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,3,0,0">
                                    <Run Text="made for" />
                                    <Run Text="{Binding Fits, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

    </StackPanel>
</UserControl>
