<Window x:Class="ModlauncherIV.App.OnlineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Play online"
        Width="720" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Back}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="26,22,26,10">
            <TextBlock Text="PLAY ONLINE" Style="{StaticResource Dim}" />
            <TextBlock Text="Where do you want to go?" Style="{StaticResource Title}" Margin="0,2,0,0" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Lead}" />

            <!-- The name comes first because nothing below works without it. It
                 is written straight into the client's own setting, so it is
                 there the next time as well - and every Connect stays off until
                 it is something a server can call you. -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="You play as" Style="{StaticResource Dim}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                <Grid Grid.Column="1">
                    <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             MaxLength="24" />
                    <TextBlock Text="a name is required"
                               Style="{StaticResource Dim}"
                               Foreground="{StaticResource Accent}"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding PlayerName, Converter={StaticResource Hide}}" />
                </Grid>

                <TextBlock Grid.Column="2" Text="{Binding Who}"
                           Style="{StaticResource Mono}" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Who}" />
            </Grid>

            <TextBlock Text="{Binding NameError}"
                       Style="{StaticResource Dim}"
                       Foreground="{StaticResource Bad}"
                       Margin="0,6,0,0"
                       Visibility="{Binding NameError, Converter={StaticResource HasContent}}" />

            <!-- The client needs a name and a game before it can join anything.
                 It asks for both in its own window - which used to be hidden,
                 and then a connect looked exactly like nothing happening. -->
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0"
                    Visibility="{Binding NotReady, Converter={StaticResource Show}}">
                <TextBlock Text="{Binding Missing}" Style="{StaticResource Dim}" Foreground="{StaticResource Accent}" />
            </Border>

            <!-- A reason on its own is bad news. Next to it stands the way the
                 client itself would have shown this list. -->
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0"
                    Visibility="{Binding ListingFailed, Converter={StaticResource Show}}">
                <StackPanel>
                    <TextBlock Text="{Binding ListingError}" Style="{StaticResource Dim}" Foreground="{StaticResource Bad}" />
                    <TextBlock Text="GTA Connected has a server browser of its own. It can be opened below - the list there is the same one."
                               Style="{StaticResource Dim}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="26,0,18,0" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Servers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Head}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Address}" Style="{StaticResource Mono}" />
                                        <TextBlock Text="{Binding Origin}"
                                                   Style="{StaticResource Dim}"
                                                   FontSize="11"
                                                   Margin="10,0,0,0"
                                                   Opacity="0.75" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Detail}"
                                               Style="{StaticResource Dim}"
                                               FontSize="11"
                                               Margin="0,3,0,0"
                                               Visibility="{Binding Detail, Converter={StaticResource HasContent}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Keep"
                                            Command="{Binding KeepCommand}"
                                            MinWidth="0" Padding="12,4" Margin="12,0,0,0"
                                            ToolTip="Remember this one here"
                                            Visibility="{Binding Saved, Converter={StaticResource Hide}}" />

                                    <Button Content="Forget"
                                            Command="{Binding ForgetCommand}"
                                            MinWidth="0" Padding="12,4" Margin="12,0,0,0"
                                            Visibility="{Binding Saved, Converter={StaticResource Show}}" />

                                    <Button Content="Connect"
                                            Command="{Binding ConnectCommand}"
                                            Style="{StaticResource Primary}"
                                            MinWidth="0" Padding="18,5" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- A server somebody just sent you is in no list yet. -->
        <StackPanel Grid.Row="2" Margin="26,12,26,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="name (optional)"
                               Style="{StaticResource Dim}"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding NewName, Converter={StaticResource Hide}}" />
                </Grid>

                <Grid Grid.Column="1" Margin="8,0,0,0">
                    <TextBox Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="host:port, e.g. 192.99.32.215:22000"
                               Style="{StaticResource Dim}"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding NewAddress, Converter={StaticResource Hide}}" />
                </Grid>

                <Button Grid.Column="2" Content="Add"
                        Command="{Binding AddServerCommand}"
                        MinWidth="0" Padding="16,5" Margin="8,0,0,0" />
            </Grid>

            <TextBlock Text="{Binding ServerError}"
                       Style="{StaticResource Dim}"
                       Foreground="{StaticResource Bad}"
                       Margin="2,6,0,0"
                       Visibility="{Binding ServerError, Converter={StaticResource HasContent}}" />
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="26,14" Margin="0,14,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" MinWidth="0" Margin="0,0,10,0" />
                    <Button Content="Server browser in GTA Connected" Command="{Binding BrowserCommand}" MinWidth="0" />
                </StackPanel>

                <Button Content="Close" Click="OnClose" HorizontalAlignment="Right" MinWidth="0" Padding="24,8" />
            </Grid>
        </Border>
    </Grid>
</Window>
