<UserControl x:Class="ModlauncherIV.App.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ModlauncherIV.App">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="38,34,38,0">
            <TextBlock Text="MODLAUNCHER IV" Style="{StaticResource Dim}" />
            <TextBlock Text="Grand Theft Auto IV" Style="{StaticResource Title}" Margin="0,2,0,0" />

            <!-- The status line sits large and at the top. It is the only question
                 anyone has on opening it: can I play? -->
            <TextBlock Text="{Binding Status}" Margin="0,16,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="Foreground" Value="{StaticResource Good}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Healthy}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Bad}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="38,20,30,0" Padding="0,0,8,0">
            <StackPanel>

                <local:SetupBannerView DataContext="{Binding Setup}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Platform}" Style="{StaticResource Head}" />
                                <TextBlock Text="{Binding GamePath}" Style="{StaticResource Mono}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Version}" Style="{StaticResource Dim}" Margin="0,6,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Open folder"
                                    Command="{Binding FolderCommand}"
                                    VerticalAlignment="Top"
                                    MinWidth="0"
                                    Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Kept apart from the recipes on purpose. These are separate
                     programs: the launcher can fetch one and start it, but there
                     is no snapshot behind it and no way back through the ledger.
                     The heading says what it is for rather than what it is,
                     because what it is for is the reason anyone looks here.
                     Worth revisiting if a tool ever arrives that is not about
                     multiplayer. -->
                <StackPanel Visibility="{Binding External.Count, Converter={StaticResource HasContent}}">
                    <TextBlock Text="PLAY ONLINE" Style="{StaticResource Dim}" Margin="0,10,0,2" />
                    <TextBlock Text="a separate program - the launcher can fetch it, but not take it back"
                               Style="{StaticResource Dim}" FontSize="11" Margin="0,0,0,8" Opacity="0.7" />

                    <ItemsControl ItemsSource="{Binding External}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Head}" />
                                            <TextBlock Text="{Binding Version}" Style="{StaticResource Dim}" Margin="0,3,0,0" />
                                            <TextBlock x:Name="State" Text="{Binding State}"
                                                       Style="{StaticResource Dim}" FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="{Binding ActionLabel}"
                                                Command="{Binding ActionCommand}"
                                                VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Fine}" Value="False">
                                        <Setter TargetName="State" Property="Foreground" Value="{StaticResource Bad}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Its own recent servers, so the usual one is one click
                         away instead of three. Empty until it has been on one. -->
                    <ItemsControl ItemsSource="{Binding Servers}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Address}"
                                               Style="{StaticResource Mono}" VerticalAlignment="Center" />

                                    <Button Grid.Column="1" Content="Connect"
                                            Command="{Binding ConnectCommand}"
                                            MinWidth="0" Padding="14,4" Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="INSTALLED" Style="{StaticResource Dim}" Margin="0,10,0,8"
                           Visibility="{Binding Mods.Count, Converter={StaticResource HasContent}}" />

                <ItemsControl ItemsSource="{Binding Mods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Head}" />
                                        <TextBlock Text="{Binding Version}" Style="{StaticResource Dim}" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <TextBlock x:Name="State" Grid.Column="1" Text="{Binding State}"
                                               Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0" />

                                    <Button Grid.Column="2" Content="Remove"
                                            Command="{Binding RemoveCommand}"
                                            VerticalAlignment="Center" Margin="14,0,0,0" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Intact}" Value="False">
                                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource Bad}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="38,18">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Manage mods" Command="{Binding WizardCommand}" Margin="0,0,10,0" />
                    <Button Content="Check" Command="{Binding VerifyCommand}" MinWidth="0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Play online"
                            Command="{Binding OnlineCommand}"
                            Margin="0,0,10,0"
                            Padding="20,12"
                            FontSize="15"
                            Visibility="{Binding HasOnline, Converter={StaticResource Show}}" />

                    <Button Content="Play GTA IV"
                            Command="{Binding PlayCommand}"
                            Style="{StaticResource Primary}"
                            Padding="34,12"
                            FontSize="15" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
