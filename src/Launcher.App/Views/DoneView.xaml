<UserControl x:Class="ModlauncherIV.App.DoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="0,4,0,20">

        <TextBlock Text="{Binding Headline}" Style="{StaticResource Title}" FontSize="18" Margin="0,0,0,12" />

        <ItemsControl ItemsSource="{Binding Installed}" Margin="0,0,0,10">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="✓ " Foreground="{StaticResource Good}" />
                        <TextBlock Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Advice}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="12">
                        <TextBlock Text="{Binding}" Style="{StaticResource Dim}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Steam am Zurückpatchen hindern"
                Click="OnLock"
                HorizontalAlignment="Left"
                MinWidth="0"
                Margin="0,4,0,0"
                Visibility="{Binding CanLockUpdates, Converter={StaticResource Show}}" />

        <TextBlock Text="{Binding LockResult}"
                   Style="{StaticResource Dim}"
                   Margin="0,8,0,0"
                   Visibility="{Binding LockResult, Converter={StaticResource HasContent}}" />

        <Button Content="GTA IV starten"
                Click="OnPlay"
                Style="{StaticResource Primary}"
                HorizontalAlignment="Left"
                Margin="0,22,0,0"
                Padding="26,11"
                IsEnabled="{Binding CanPlay}" />

        <TextBlock Text="Im Spiel öffnet F7 das Trainer-Menü, sofern du es eingebaut hast."
                   Style="{StaticResource Dim}"
                   Margin="0,10,0,0" />

    </StackPanel>
</UserControl>
