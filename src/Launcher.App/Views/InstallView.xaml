<UserControl x:Class="ModlauncherIV.App.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="0,4,0,20">

        <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,0,0,10">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#26E06C5A" BorderBrush="{StaticResource Bad}" BorderThickness="1"
                            CornerRadius="4" Padding="12,9" Margin="0,0,0,6">
                        <TextBlock Text="{Binding}" Foreground="{StaticResource Text}" FontSize="12" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="No installation was found. Point it at the folder holding GTAIV.exe."
                   Style="{StaticResource Dim}"
                   Margin="0,0,0,10"
                   Visibility="{Binding NothingFound, Converter={StaticResource Show}}" />

        <ListBox ItemsSource="{Binding Found}" SelectedItem="{Binding Selected}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd"
                                        Background="{StaticResource Panel}"
                                        BorderBrush="{StaticResource Line}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="14">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHi}" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True" />
                                            <Condition Property="IsSelected" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextDim}" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Platform}" Style="{StaticResource Head}" />
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Version}" Style="{StaticResource Dim}" />
                            <TextBlock Text=" · " Style="{StaticResource Dim}" />
                            <TextBlock Text="{Binding Extras}" Style="{StaticResource Dim}" />
                            <TextBlock Text=" · " Style="{StaticResource Dim}" />
                            <TextBlock Text="{Binding Mods}" Style="{StaticResource Dim}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="{Binding Error}"
                   Foreground="{StaticResource Bad}"
                   FontSize="12"
                   Margin="0,4,0,0"
                   Visibility="{Binding Error, Converter={StaticResource HasContent}}" />

        <Button Content="Pick the folder by hand ..."
                Click="OnBrowse"
                HorizontalAlignment="Left"
                MinWidth="0"
                Margin="0,10,0,0" />

    </StackPanel>
</UserControl>
