<UserControl x:Class="ModlauncherIV.App.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ItemsControl ItemsSource="{Binding Points}" Margin="0,4,0,20">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Head}" Style="{StaticResource Head}" />
                        <TextBlock Text="{Binding Text}" Style="{StaticResource Dim}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</UserControl>
