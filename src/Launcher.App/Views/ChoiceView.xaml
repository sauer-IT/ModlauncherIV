<UserControl x:Class="ModlauncherIV.App.ChoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- A mod the chosen version cannot take is still shown - taking it out
             of the list would leave the user wondering where it went. It is
             dimmed and cannot be ticked, and says why. -->
        <Style x:Key="ModCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Available}" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <StackPanel Margin="0,4,0,20">

        <TextBlock Text="GAME VERSION" Style="{StaticResource Dim}" Margin="0,0,0,8" />

        <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Target}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd"
                                        Background="{StaticResource Panel}"
                                        BorderBrush="{StaticResource Line}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="14,11">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHi}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Head}" />
                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Dim}" Margin="0,3,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Heading and search box on one line: the box belongs to the list
             below it, and a search box hunted for in a corner is no search box. -->
        <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="MODS" Style="{StaticResource Dim}" VerticalAlignment="Center" />

            <Grid Grid.Column="1" Width="210">
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                <TextBlock Text="Search"
                           Style="{StaticResource Dim}"
                           Margin="11,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding Filter, Converter={StaticResource Hide}}" />
            </Grid>
        </Grid>

        <TextBlock Text="The catalog is empty. Without a valid signature the wizard loads no recipes - see the message in the previous step."
                   Style="{StaticResource Dim}"
                   Foreground="{StaticResource Bad}"
                   Visibility="{Binding Recipes.Count, Converter={StaticResource Hide}}" />

        <TextBlock Text="Nothing matches that. Clear the search to see everything again."
                   Style="{StaticResource Dim}"
                   Margin="0,4,0,0"
                   Visibility="{Binding NothingMatches, Converter={StaticResource Show}}" />

        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,14">

                        <Grid Margin="2,0,2,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Name}" Style="{StaticResource GroupHead}" />

                            <Border Grid.Column="1"
                                    Height="1"
                                    Background="{StaticResource Line}"
                                    Margin="10,0,10,0"
                                    VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Count}"
                                       Style="{StaticResource Dim}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{Binding Note}"
                                   Style="{StaticResource Dim}"
                                   Margin="2,0,0,8"
                                   Visibility="{Binding Note, Converter={StaticResource HasContent}}" />

                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding Selected}"
                                                          IsEnabled="{Binding Available}"
                                                          Content="{Binding Name}"
                                                          FontWeight="SemiBold" />

                                                <TextBlock Text="{Binding ShortDescription}"
                                                           Style="{StaticResource Dim}"
                                                           Margin="24,4,0,0"
                                                           ToolTip="{Binding Description}"
                                                           Visibility="{Binding ShortDescription, Converter={StaticResource HasContent}}" />

                                                <StackPanel Orientation="Horizontal" Margin="24,7,0,0">

                                                    <Border Style="{StaticResource Chip}"
                                                            Visibility="{Binding Installed, Converter={StaticResource Show}}">
                                                        <TextBlock Text="installed"
                                                                   Style="{StaticResource ChipText}"
                                                                   Foreground="{StaticResource Good}" />
                                                    </Border>

                                                    <Border Style="{StaticResource Chip}"
                                                            Visibility="{Binding ByHand, Converter={StaticResource Show}}">
                                                        <TextBlock Text="you download this one yourself"
                                                                   Style="{StaticResource ChipText}"
                                                                   Foreground="{StaticResource Accent}" />
                                                    </Border>

                                                    <Border Style="{StaticResource Chip}"
                                                            Visibility="{Binding UnavailableBecause, Converter={StaticResource HasContent}}">
                                                        <TextBlock Text="{Binding UnavailableBecause}"
                                                                   Style="{StaticResource ChipText}"
                                                                   Foreground="{StaticResource Bad}" />
                                                    </Border>

                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SizeText}"
                                                       Style="{StaticResource Mono}"
                                                       Margin="10,1,0,0"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding Summary}"
                   Style="{StaticResource Dim}"
                   Margin="2,2,0,0"
                   Visibility="{Binding Summary, Converter={StaticResource HasContent}}" />

    </StackPanel>
</UserControl>
