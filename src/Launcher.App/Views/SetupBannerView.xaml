<UserControl x:Class="ModlauncherIV.App.SetupBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Border Background="#269E5710" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                CornerRadius="4" Padding="14" Margin="0,0,0,10"
                Visibility="{Binding Visible, Converter={StaticResource Show}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Head}" />
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Dim}" Margin="0,5,12,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Set up"
                        Command="{Binding SetupCommand}"
                        Style="{StaticResource Primary}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock Text="{Binding Result}"
                   Style="{StaticResource Dim}"
                   Margin="0,0,0,10"
                   Visibility="{Binding Result, Converter={StaticResource HasContent}}" />
    </StackPanel>
</UserControl>
