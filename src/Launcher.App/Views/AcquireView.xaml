<UserControl x:Class="ModlauncherIV.App.AcquireView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="0,4,0,20">

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource Head}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding RecipeName}" Style="{StaticResource Dim}" />
                                        <TextBlock Text=" · " Style="{StaticResource Dim}" />
                                        <TextBlock Text="{Binding Size}" Style="{StaticResource Dim}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding State}" Style="{StaticResource Dim}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>

                            <ProgressBar Value="{Binding Percent}" Maximum="100" Margin="0,10,0,0"
                                         Visibility="{Binding Percent, Converter={StaticResource HasContent}}" />

                            <TextBlock Text="{Binding Hint}"
                                       Foreground="{StaticResource Bad}"
                                       FontSize="12"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding Hint, Converter={StaticResource HasContent}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding Status}" Style="{StaticResource Dim}" Margin="0,8,0,0" />

        <!-- Fehlt eine Datei, die wir nicht selbst laden duerfen, ist die einzige
             brauchbare Hilfe: sagen, wohin sie gehoert, und den Ordner oeffnen. -->
        <StackPanel Visibility="{Binding NeedsUser, Converter={StaticResource Show}}" Margin="0,14,0,0">
            <TextBlock Text="Arbeitsordner:" Style="{StaticResource Dim}" />
            <TextBlock Text="{Binding CacheFolder}" Style="{StaticResource Mono}" Margin="0,4,0,10" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal">
                <Button Content="Ordner öffnen" Click="OnOpenFolder" MinWidth="0" Margin="0,0,8,0" />
                <Button Content="Erneut prüfen" Click="OnRetry" MinWidth="0" />
            </StackPanel>
        </StackPanel>

    </StackPanel>
</UserControl>
