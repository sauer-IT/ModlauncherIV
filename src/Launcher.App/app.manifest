<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <assemblyIdentity version="1.0.0.0" name="ModlauncherIV.app" />

  <!--
    The launcher requires administrator rights.

    On Steam as on Rockstar, GTA IV sits under C:\Program Files. Writing there
    means elevated rights, and not only while installing: the snapshot, without
    which there is no rollback, is put there too.

    The alternative would be to start without rights and relaunch only once
    something has to be written. That would mean: the wizard from the top, the
    selection gone, and in the worst case a half-applied recipe, because the
    elevation lands in the middle of a transaction. One prompt up front is more
    honest.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. Without this entry Windows reports older version
           numbers, and the detection would come up empty. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

</assembly>
